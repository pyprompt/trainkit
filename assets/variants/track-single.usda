#usda 1.0
(
    defaultPrim = "Asset"
    upAxis = "Y"
    metersPerUnit = 1
)

def Xform "Asset" (
    variants = { string model = "standard" }
    prepend variantSets = "model"
)
{
    variantSet "model" = {
        "detailed" (
            prepend references = @../models/track-single-detailed.usd@
        ) {}
        "standard" (
            prepend references = @../models/track-single.usd@
        ) {}
    }
}
