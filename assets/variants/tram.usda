#usda 1.0
(
    defaultPrim = "Tram"
    upAxis = "Y"
    metersPerUnit = 1
)

def Xform "Tram" (
    variants = { string model = "classic" }
    prepend variantSets = "model"
)
{
    variantSet "model" = {
        "classic" (
            prepend references = @../models/train-tram-classic.usd@
        ) {}
        "modern" (
            prepend references = @../models/train-tram-modern.usd@
        ) {}
        "round" (
            prepend references = @../models/train-tram-round.usd@
        ) {}
    }
}
