#usda 1.0
(
    defaultPrim = "Asset"
    upAxis = "Y"
    metersPerUnit = 1
)

def Xform "Asset" (
    variants = { string model = "a" }
    prepend variantSets = "model"
)
{
    variantSet "model" = {
        "a" (
            prepend references = @../models/train-diesel-box-a.usd@
        ) {}
        "b" (
            prepend references = @../models/train-diesel-box-b.usd@
        ) {}
        "c" (
            prepend references = @../models/train-diesel-box-c.usd@
        ) {}
    }
}
